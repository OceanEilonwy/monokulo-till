<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	What makes this a Notification Service Extension, which no INFOPLIST_KEY_
	build setting can say; the rest are generated (GENERATE_INFOPLIST_FILE)
	and merged in.
	-->
	<key>NSExtension</key>
	<dict>
		<key>NSExtensionPointIdentifier</key>
		<string>com.apple.usernotifications.service</string>
		<key>NSExtensionPrincipalClass</key>
		<string>$(PRODUCT_MODULE_NAME).NotificationService</string>
	</dict>
	<!--
	The points of sale's application ids and environments, from the build
	settings of the same names (project.yml, release-ios.yml), for Build.swift.
	-->
	<key>TillSquareApplicationId</key>
	<string>$(TILL_SQUARE_APPLICATION_ID)</string>
	<key>TillSquareSandbox</key>
	<string>$(TILL_SQUARE_SANDBOX)</string>
	<key>TillCloverApplicationId</key>
	<string>$(TILL_CLOVER_APPLICATION_ID)</string>
	<key>TillCloverEnvironment</key>
	<string>$(TILL_CLOVER_ENVIRONMENT)</string>
</dict>
</plist>
