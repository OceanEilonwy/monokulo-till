<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	The keys Xcode can't generate from INFOPLIST_KEY_ build settings; the
	rest are generated (GENERATE_INFOPLIST_FILE) and merged in. The
	monokulo-till scheme: a point of sale's sign-in may come back on it
	(docs/decisions/core.md 22).
	-->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.monokulo.till</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>monokulo-till</string>
			</array>
		</dict>
	</array>
	<!--
	The Live Activity is updated often while a sale waits (docs/design.md §6);
	said here as well as by INFOPLIST_KEY_, in case Xcode doesn't take that
	key from a build setting.
	-->
	<key>NSSupportsLiveActivitiesFrequentUpdates</key>
	<true/>
</dict>
</plist>
