<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	The keys Xcode can't generate from INFOPLIST_KEY_ build settings; the
	rest are generated (GENERATE_INFOPLIST_FILE) and merged in. The
	monokulo-till scheme: a point of sale's sign-in may come back on it
	(docs/decisions/core.md 22).
	-->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.monokulo.till</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>monokulo-till</string>
			</array>
		</dict>
	</array>
	<!--
	Paid's "Back to Square" on iPad opens Square Point of Sale by its scheme,
	and shows only when canOpenURL says Square is installed, which needs the
	scheme listed here (docs/ipad-redesign.md decision 1).
	-->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>square-commerce-v1</string>
	</array>
	<!--
	The Live Activity is updated often while a sale waits (docs/design.md §6);
	said here as well as by INFOPLIST_KEY_, in case Xcode doesn't take that
	key from a build setting.
	-->
	<key>NSSupportsLiveActivitiesFrequentUpdates</key>
	<true/>
	<!--
	The points of sale's application ids and environments, and the push relay
	and Bell, and the universal links' host, from the build
	settings of the same names (project.yml, release-ios.yml), for Build.swift.
	-->
	<key>TillSquareApplicationId</key>
	<string>$(TILL_SQUARE_APPLICATION_ID)</string>
	<key>TillSquareSandbox</key>
	<string>$(TILL_SQUARE_SANDBOX)</string>
	<key>TillCloverApplicationId</key>
	<string>$(TILL_CLOVER_APPLICATION_ID)</string>
	<key>TillCloverEnvironment</key>
	<string>$(TILL_CLOVER_ENVIRONMENT)</string>
	<key>TillRelayUrl</key>
	<string>$(TILL_RELAY_URL)</string>
	<key>TillBellUrl</key>
	<string>$(TILL_BELL_URL)</string>
	<key>TillLinkHost</key>
	<string>$(TILL_LINK_HOST)</string>
</dict>
</plist>
