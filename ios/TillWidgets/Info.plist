<plist version="1.0">
<dict>
	<!--
	The widget extension's point, which no INFOPLIST_KEY_ setting can say;
	the rest is generated (GENERATE_INFOPLIST_FILE) and merged in.
	-->
	<key>NSExtension</key>
	<dict>
		<key>NSExtensionPointIdentifier</key>
		<string>com.apple.widgetkit-extension</string>
	</dict>
</dict>
</plist>
